# NEXUS backend configuration.
#
#   cp .env.example .env
#
# Every variable is read with the NEXUS_ prefix. Values shown are the defaults;
# uncomment only what you need to change. The process validates all of this at
# startup and refuses to run if something is wrong — see nexus/core/config.py.

# ----------------------------------------------------------------- core -----
# development | testing | production
# Production additionally requires a real SECRET_KEY, secure cookies, and
# explicit CORS origins.
NEXUS_ENVIRONMENT=development

# ------------------------------------------------------------- database -----
# Must use the asyncpg driver.
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
#NEXUS_DB_POOL_SIZE=10
#NEXUS_DB_MAX_OVERFLOW=10
#NEXUS_DB_POOL_TIMEOUT_SECONDS=10
#NEXUS_DB_STATEMENT_TIMEOUT_SECONDS=30
# How many times to retry the database at startup before starting degraded.
#NEXUS_DB_CONNECT_RETRIES=5

# -------------------------------------------------------------- runtime -----
#NEXUS_HOST=127.0.0.1
#NEXUS_PORT=8000
# Writable directory for evidence files, backups, and the audit mirror.
#NEXUS_DATA_DIR=./var

# -------------------------------------------------------------- logging -----
#NEXUS_LOG_LEVEL=INFO
# json for production and log shipping, console for a readable terminal.
#NEXUS_LOG_FORMAT=json

# --------------------------------------------------------------- crypto -----
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every CSRF token in flight (users retry once); it
# does not invalidate sessions, which are server-side.
#NEXUS_SECRET_KEY=

# ------------------------------------------------------------- sessions -----
#NEXUS_SESSION_COOKIE_NAME=nexus_session
# Hard cap on session lifetime regardless of activity (minutes).
#NEXUS_SESSION_ABSOLUTE_TTL_MINUTES=720
# Idle timeout (minutes).
#NEXUS_SESSION_IDLE_TIMEOUT_MINUTES=60
# Set false ONLY for plain-HTTP local development. Production rejects false.
#NEXUS_SESSION_COOKIE_SECURE=true

# ----------------------------------------------------------------- http -----
# Comma-separated. Needed when the frontend dev server runs on another origin.
#NEXUS_CORS_ORIGINS=http://localhost:5173
#NEXUS_MAX_REQUEST_BODY_BYTES=1048576
# Number of trusted reverse proxies in front of NEXUS. 0 means X-Forwarded-For
# is ignored entirely — correct unless you actually run behind a proxy, since
# otherwise clients can forge the source IP recorded in the audit log.
#NEXUS_TRUSTED_PROXY_HOPS=0

# ----------------------------------------------------------- monitoring -----
# CIDR blocks you own and are authorised to monitor. Comma-separated.
# THIS IS A SAFETY BOUNDARY: quarantine and any active network operation refuse
# to touch an address outside these ranges. Leaving it empty means no address is
# considered local, and every active operation is refused.
#NEXUS_MONITORED_NETWORKS=192.168.1.0/24

# ------------------------------------------------------------ retention -----
#NEXUS_EVENT_RETENTION_DAYS=90
#NEXUS_AUDIT_RETENTION_DAYS=365

# -------------------------------------------------------------- workers -----
#NEXUS_WORKER_CONCURRENCY=4
#NEXUS_WORKER_POLL_INTERVAL_SECONDS=1.0
#NEXUS_JOB_DEFAULT_TIMEOUT_SECONDS=120
#NEXUS_JOB_MAX_ATTEMPTS=5

# --------------------------------------------------------- rate limits -----
#NEXUS_LOGIN_RATE_LIMIT_PER_MINUTE=10
#NEXUS_API_RATE_LIMIT_PER_MINUTE=600
