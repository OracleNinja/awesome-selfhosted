# ============================================================
# JARVIS configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# Every value below is read server-side only. No secret in this
# file is ever sent to the browser.
# ============================================================

# ---------- Core ----------
# Which model provider the orchestrator uses: nvidia | anthropic | openai | local
MODEL_PROVIDER=nvidia

# HTTP port for the JARVIS server (the web UI proxies to this in dev).
PORT=8787

# Shared secret required by every /api request (sent as `Authorization: Bearer ...`).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, JARVIS binds to localhost only and runs in single-user local mode.
JARVIS_API_TOKEN=

# Directory the file_read / file_write tools are confined to (path-escape is rejected).
JARVIS_WORKSPACE_DIR=./workspace

# ---------- Database ----------
# SQLite file path. `file:` URLs and bare paths are both accepted.
DATABASE_URL=file:./data/jarvis.db

# ---------- NVIDIA (build.nvidia.com / NIM) ----------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------- OpenAI-compatible (OpenAI, Groq, Together, vLLM, ...) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Local inference (future NVIDIA GPU / llama.cpp / Ollama / vLLM) ----------
# Any OpenAI-compatible local endpoint. Leave blank to mark the provider unavailable.
LOCAL_BASE_URL=
LOCAL_MODEL=
LOCAL_API_KEY=

# ---------- Voice ----------
# STT_PROVIDER: browser | nvidia    (browser = Web Speech API, runs client-side)
STT_PROVIDER=browser
# TTS_PROVIDER: browser | nvidia    (browser = speechSynthesis, runs client-side)
TTS_PROVIDER=browser

# NVIDIA Riva / NIM speech endpoints. Both are required for the nvidia voice providers
# to report themselves as available.
NVIDIA_STT_URL=
NVIDIA_STT_MODEL=
NVIDIA_TTS_URL=
NVIDIA_TTS_MODEL=
NVIDIA_TTS_VOICE=

# ---------- Image / video / vision ----------
# IMAGE_PROVIDER: none | nvidia
IMAGE_PROVIDER=none
NVIDIA_IMAGE_URL=
NVIDIA_IMAGE_MODEL=

# IMAGE_EDIT_PROVIDER: none | nvidia
IMAGE_EDIT_PROVIDER=none
NVIDIA_IMAGE_EDIT_URL=
NVIDIA_IMAGE_EDIT_MODEL=

# VIDEO_PROVIDER: none | nvidia
VIDEO_PROVIDER=none
NVIDIA_VIDEO_URL=
NVIDIA_VIDEO_MODEL=

# VISION_PROVIDER: none | nvidia
VISION_PROVIDER=none
NVIDIA_VISION_MODEL=

# ---------- Web search (tool: web_search) ----------
# SEARCH_PROVIDER: none | searxng | brave | tavily
SEARCH_PROVIDER=none
SEARXNG_URL=
BRAVE_API_KEY=
TAVILY_API_KEY=

# ---------- Approvals ----------
# Risk levels that always require an explicit human approval before execution.
# Comma-separated subset of: READ,WRITE,EXTERNAL_ACTION,DESTRUCTIVE
APPROVAL_REQUIRED_LEVELS=EXTERNAL_ACTION,DESTRUCTIVE

# Seconds a pending approval stays valid before it expires.
APPROVAL_TIMEOUT_SECONDS=900
