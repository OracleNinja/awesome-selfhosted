# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Both values are safe in the browser: the anon key
# only ever grants what row level security allows.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key in this file or in any VITE_ variable.
