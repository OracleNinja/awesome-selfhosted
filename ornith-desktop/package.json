{
  "name": "ornith-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A native macOS desktop chat app for local Ollama models.",
  "author": "Ornith Desktop",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "dev.ornith.desktop",
    "productName": "Ornith Desktop",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
