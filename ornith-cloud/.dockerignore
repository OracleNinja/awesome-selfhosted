# Secrets must never enter the build context. Even with multi-stage builds, a
# file copied into any layer is recoverable from the image.
.env
.env.*
!.env.example

# Rebuilt inside the image; copying host artifacts risks a stale or
# wrong-architecture binary.
node_modules
dist
coverage

# Tests are compiled by tsconfig's include list, so excluding them here keeps
# test code out of the production image entirely.
tests

.git
.gitignore
.github

Dockerfile
.dockerignore
README.md
*.log
.DS_Store
