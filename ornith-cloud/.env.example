# Ornith Cloud Gateway — copy to .env and fill in. Never commit .env.

# --- required -------------------------------------------------------------

# Bearer token the desktop must present. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORNITH_GATEWAY_TOKEN=

# --- AI provider ----------------------------------------------------------

# anthropic | stub   (stub streams canned text and needs no key; for testing)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model used for normal questions.
ORNITH_ONLINE_MODEL=claude-sonnet-4-5
# Cheaper/faster model for arithmetic, conversions and greetings.
ORNITH_FAST_MODEL=claude-haiku-4-5
ORNITH_MAX_OUTPUT_TOKENS=2048

# --- retrieval ------------------------------------------------------------

# A SearXNG instance. Leave unset to disable web retrieval entirely.
# Hosted search (Brave Search API). Preferred for Phase 2.
SEARCH_API_KEY=

# Self-hosted alternative; used only when SEARCH_API_KEY is unset.
SEARXNG_URL=

ORNITH_SEARCH_RESULTS=5
ORNITH_DOCUMENTS_FETCHED=3
ORNITH_MAX_DOCUMENT_CHARS=20000
ORNITH_MAX_CONTEXT_CHARS=50000

# --- timeouts (ms) --------------------------------------------------------

ORNITH_SEARCH_TIMEOUT_MS=8000
ORNITH_FETCH_TIMEOUT_MS=8000
ORNITH_PROVIDER_TIMEOUT_MS=60000

# --- cache ----------------------------------------------------------------

ORNITH_SEARCH_CACHE_MS=60000
ORNITH_DOCUMENT_CACHE_MS=300000
ORNITH_CACHE_MAX_ENTRIES=500

# --- server ---------------------------------------------------------------

PORT=8787
LOG_LEVEL=info
