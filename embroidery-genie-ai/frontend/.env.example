# The FastAPI backend. In development, next.config.mjs proxies /api/v1 here so
# the browser stays on one origin.
BACKEND_URL=http://localhost:8000

# Supabase — the browser talks to Supabase directly for sign-in, then sends the
# resulting JWT to the backend as a bearer token.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave unset to use the same origin (recommended with the proxy above).
NEXT_PUBLIC_API_BASE_URL=
