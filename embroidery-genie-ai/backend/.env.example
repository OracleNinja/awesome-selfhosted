# ---------------------------------------------------------------- runtime
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://genie:genie@localhost:5432/embroidery_genie

# --------------------------------------------------------------- supabase
# Client-side auth uses SUPABASE_URL + the anon key (see frontend/.env.example).
# The backend needs a way to VERIFY the JWTs Supabase issues:
#   - legacy HS256 projects: set SUPABASE_JWT_SECRET
#   - current asymmetric projects: SUPABASE_URL is enough (JWKS is fetched)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=designs

# Local development without Supabase: every request is treated as one fixed
# user. The app REFUSES TO START with this enabled in production.
ALLOW_DEV_AUTH=true

# ---------------------------------------------------------------- storage
STORAGE_BACKEND=local            # local | supabase
LOCAL_STORAGE_PATH=./storage

# --------------------------------------------------------------------- ai
# Entirely optional. Without a key the analyzer still runs — it uses computer
# vision only and reports no semantic detection. Scores, stitch counts,
# pricing, validation and export are deterministic and never involve a model.
# Full detail: docs/AI_COST_CONTROLS.md
AI_ENABLED=true                  # global kill switch; false stops every AI call
AI_PROVIDER=auto                 # auto | openai | anthropic | none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Per-operation kill switch. Shuts one operation off without taking the layer
# down with it.
VISION_ANALYSIS_ENABLED=true

# Model routing. Business logic asks for a tier; these are the only places a
# model id appears. LOW = bounded extraction, MEDIUM = modest reasoning,
# HIGH = the strongest model, VISION = vision-capable.
AI_MODEL_ANTHROPIC_LOW=claude-haiku-4-5
AI_MODEL_ANTHROPIC_MEDIUM=claude-sonnet-5
AI_MODEL_ANTHROPIC_HIGH=claude-opus-5
AI_MODEL_ANTHROPIC_VISION=claude-haiku-4-5
AI_MODEL_OPENAI_LOW=gpt-4o-mini
AI_MODEL_OPENAI_MEDIUM=gpt-4o-mini
AI_MODEL_OPENAI_HIGH=gpt-4o
AI_MODEL_OPENAI_VISION=gpt-4o-mini

# Per-request bounds. Artwork is downscaled to AI_IMAGE_MAX_EDGE_PX before it
# is sent — vision input is priced by pixel area and nothing in the semantic
# pass needs print resolution. Measured effect: roughly half the input tokens
# of sending full-size artwork, and ~80% less against a high-resolution tier.
AI_IMAGE_MAX_EDGE_PX=1024
AI_IMAGE_JPEG_QUALITY=82
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=700         # output is never unbounded
AI_MAX_ATTEMPTS=3                # every retry is a billed request
AI_RETRY_BACKOFF_SECONDS=1.0
AI_TIMEOUT_SECONDS=45

# Budgets. Two units at every scope: tokens always bind, dollars bind only for
# models priced in config/ai_pricing.json. 0 disables that particular limit.
# Reaching a limit stops the AI call — it does not stop the product.
AI_DAILY_TOKENS_PER_USER=120000
AI_DAILY_TOKENS_PER_TENANT=400000
AI_MONTHLY_TOKENS_PER_TENANT=4000000
AI_MONTHLY_TOKENS_GLOBAL=60000000
AI_DAILY_COST_PER_USER_USD=0
AI_DAILY_COST_PER_TENANT_USD=0
AI_MONTHLY_COST_PER_TENANT_USD=25
AI_MONTHLY_COST_GLOBAL_USD=400
AI_BUDGET_OVERRIDE=false         # an administrator deliberately spending past 100%

# Beta cost mode: conservative token limits and fewer retries. Leave it on
# until you have measured your own usage.
AI_BETA_COST_MODE=true

# Result cache. Tenant-scoped: entries are unique per workspace and no cross
# tenant read is possible.
AI_CACHE_ENABLED=true
AI_CACHE_TTL_DAYS=30

# Cost accounting. Rates are operator-maintained configuration, not business
# logic — a model with no entry records tokens with a null cost, never a guess.
AI_PRICING_FILE=config/ai_pricing.json
AI_ADMIN_EMAILS=                 # comma-separated; may view service-wide spend

# ----------------------------------------------------------------- limits
MAX_UPLOAD_MB=25
FREE_DESIGNS_PER_MONTH=5

# ---------------------------------------------------------------- pricing
DEFAULT_CURRENCY=USD
DEFAULT_LABOR_RATE_PER_HOUR=28
DEFAULT_MACHINE_RATE_PER_HOUR=18
DEFAULT_DIGITIZING_FEE=45
