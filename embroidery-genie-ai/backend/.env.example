# ---------------------------------------------------------------- runtime
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://genie:genie@localhost:5432/embroidery_genie

# --------------------------------------------------------------- supabase
# Client-side auth uses SUPABASE_URL + the anon key (see frontend/.env.example).
# The backend needs a way to VERIFY the JWTs Supabase issues:
#   - legacy HS256 projects: set SUPABASE_JWT_SECRET
#   - current asymmetric projects: SUPABASE_URL is enough (JWKS is fetched)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=designs

# Local development without Supabase: every request is treated as one fixed
# user. The app REFUSES TO START with this enabled in production.
ALLOW_DEV_AUTH=true

# ---------------------------------------------------------------- storage
STORAGE_BACKEND=local            # local | supabase
LOCAL_STORAGE_PATH=./storage

# --------------------------------------------------------------------- ai
# Entirely optional. Without a key the analyzer still runs — it uses computer
# vision only and reports no semantic detection.
AI_PROVIDER=auto                 # auto | openai | anthropic | none
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5

# ----------------------------------------------------------------- limits
MAX_UPLOAD_MB=25
FREE_DESIGNS_PER_MONTH=5

# ---------------------------------------------------------------- pricing
DEFAULT_CURRENCY=USD
DEFAULT_LABOR_RATE_PER_HOUR=28
DEFAULT_MACHINE_RATE_PER_HOUR=18
DEFAULT_DIGITIZING_FEE=45
